# ──────────────────────────────────────────────────────────────────────────────
# Distributed Rate Limiter — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env to Git (it may contain real secrets).
# .env is listed in .gitignore.
#
# All values shown here are the application defaults.
# You only need to set a variable if you want to override the default.
# ──────────────────────────────────────────────────────────────────────────────

# HTTP Server
APP_PORT=8080
SERVER_READ_TIMEOUT_SECONDS=5
SERVER_WRITE_TIMEOUT_SECONDS=10
SERVER_IDLE_TIMEOUT_SECONDS=120

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis failure behaviour:
#   fail_open  = allow requests if Redis is unreachable (prioritise availability)
#   fail_closed = deny requests if Redis is unreachable (prioritise protection)
REDIS_FAILURE_MODE=fail_open

# Rate Limiting Algorithm
# Options: token_bucket | fixed_window | sliding_window
LIMITER_ALGORITHM=token_bucket

# Token Bucket settings (used when LIMITER_ALGORITHM=token_bucket)
LIMITER_CAPACITY=100        # max tokens (burst limit)
LIMITER_REFILL_RATE=10.0    # tokens added per second (sustained rate)

# Fixed / Sliding Window settings (used for the other two algorithms)
LIMITER_WINDOW_SECONDS=60   # window duration in seconds
LIMITER_DEFAULT_LIMIT=100   # max requests per window
